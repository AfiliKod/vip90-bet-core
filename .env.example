# ─── Core ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/betzone?retryWrites=true&w=majority
CLIENT_URL=https://vip90.bet

# MongoDB connection pool tuning (Phase E7)
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# ─── Secrets (Phase B4 — rotate BEFORE live launch) ────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_random_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_random_64_chars_different_from_jwt_secret

# ─── Casino provider (Palace) ─────────────────────────────────────
PALACE_API_BASE=https://api.casino-provider.example
PALACE_API_TOKEN=CHANGE_ME_palace_api_token
PALACE_CALLBACK_TOKEN=CHANGE_ME_palace_callback_token

# ─── Crypto (TRC20 USDT) ──────────────────────────────────────────
USDT_TRY_RATE=35
TRONGRID_API_KEY=optional_trongrid_api_key_for_better_rate_limits

# ─── AI Help (OpenRouter) ─────────────────────────────────────────
AI_HELP_BASE_URL=https://openrouter.ai/api/v1
AI_HELP_API_KEY=CHANGE_ME_openrouter_api_key
AI_HELP_MODEL=anthropic/claude-3-haiku

# ─── Transactional email (Phase C9 — SMTP) ────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vip90.bet
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@vip90.bet

# ─── Monitoring & alerting (Phase C2/C3) ──────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/123456
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME/CHANGE_ME/CHANGE_ME

# ─── Bot protection (Phase B8 — Cloudflare Turnstile) ─────────────
TURNSTILE_SITE_KEY=CHANGE_ME_or_leave_empty_to_disable
TURNSTILE_SECRET=CHANGE_ME_or_leave_empty_to_disable

# ─── Admin security (Phase B15) ───────────────────────────────────
# CIDR list, comma-separated. Production: sadece VPN/ofis IP'leri
ADMIN_ALLOWED_IPS=

# ─── Rate limiting tunables (Phase B1) ────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=5
FINANCIAL_RATE_LIMIT_MAX=10

# ─── Feature flags ────────────────────────────────────────────────
DISABLE_TURNSTILE=true
LEGAL_VERSION=1.0.0

# ─── Email verification (Phase A — grandfathering) ─────────────────
# Email doğrulama zorunluluğu cutoff tarihi (ISO 8601). Bu tarihten ÖNCE kayıt olan
# kullanıcılar login()'de email doğrulama zorunluluğundan muaf tutulur (grandfathering).
# Deploy günü gerçek deploy zamanına göre ayarlanmalı — boş bırakılırsa koddaki
# varsayılana (2026-07-14T00:00:00Z) düşer.
EMAIL_VERIFICATION_CUTOFF=

# ─── Slikair Ödeme Ağ Geçidi ───────────────────────────────────────
# Sandbox: https://sandbox.slikair.online/dashboard
# Production: Slikair merchant panelinden alınır.
SLIKAIR_MERCHANT_ID=
SLIKAIR_MERCHANT_TOKEN=
SLIKAIR_SITE_ID=
SLIKAIR_BASE_URL=https://sandbox.slikair.online/api/v2
SLIKAIR_WEBHOOK_SECRET=
# API_BASE_URL: Webhook'ların bildirildiği public URL (ör: https://api.vip90.bet)
API_BASE_URL=