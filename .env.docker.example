# VIP90.bet Docker kurulumu için ortam değişkenleri.
# Kullanım: cp .env.docker.example .env  → değerleri doldur → docker compose up -d
#
# MONGODB_URI'yi .env'e KOYMA — docker-compose.yml onu compose içi mongo
# servisine (mongodb://mongo:27017/betzone) otomatik yönlendirir.
# Zorunlu alanların tam listesi için server/.env.example'a bak.

# ─── Zorunlu ──────────────────────────────────────────────────────
# Caddy'nin sertifika alacağı alan adı. Boş bırakılırsa localhost
# kabul edilir ve self-signed sertifikayla açılır.
DOMAIN=localhost

JWT_SECRET=BURAYA_RANDOM_64_CHARS_openssl_rand_base64_64
JWT_REFRESH_SECRET=BURAYA_FARKLI_RANDOM_64_CHARS

# Tarayıcıdan erişilecek genel adres (domain varsa https:// ile)
CLIENT_URL=https://localhost

# ─── Casino sağlayıcısı (Casino Content eklentisini kullanacaksan) ─
# Casino Content eklentisi (Palace/Igames aggregator) kurulu değilse boş bırak.
PALACE_API_BASE=https://api.casino-provider.example
PALACE_API_TOKEN=CHANGE_ME_palace_token
PALACE_CALLBACK_TOKEN=CHANGE_ME_palace_callback_token

# ─── E-posta (şifre sıfırlama vb.) ────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@example.com

# ─── Opsiyonel ────────────────────────────────────────────────────
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Cloudflare Turnstile: İKİSİ de doluysa register/login/forgot-password
# doğrulama ister. Boşsa kapalı. DISABLE_TURNSTILE=true her durumda atlar.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DISABLE_TURNSTILE=

# /api/admin/* için virgüllü IP/CIDR listesi (boşsa kısıt yok)
ADMIN_ALLOWED_IPS=

# ─── Çekirdek dışı / modül ayarları ───────────────────────────────
# Slikair ödeme ağ geçidi (bkz. server/.env.example)
SLIKAIR_MERCHANT_ID=
SLIKAIR_MERCHANT_TOKEN=
SLIKAIR_SITE_ID=
SLIKAIR_BASE_URL=https://sandbox.slikair.online/api/v2
SLIKAIR_WEBHOOK_SECRET=
API_BASE_URL=

# Kripto ödeme modülü (USDT TRC20) — gizli tut, yedekle
USDT_TRY_RATE=35
TRON_NETWORK=mainnet
CRYPTO_SEED_PHRASE=
HOT_WALLET_PRIVATE_KEY=

# AES-256-GCM sır şifreleme anahtarı, 64 hex karakter:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Panelden kaydedilen entegrasyon sırları (SMTP, Slikair...) için gerekli.
OPERATOR_SECRET_ENCRYPTION_KEY=

# Destek chatbot'u (OpenRouter)
AI_HELP_BASE_URL=https://openrouter.ai/api/v1
AI_HELP_API_KEY=
AI_HELP_MODEL=anthropic/claude-3-haiku

# Sosyal giriş
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/api/auth/google/callback
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Merkez lisans sunucusu (yoksa boş bırak)
LICENSE_SERVER_URL=
LICENSE_KEY=
CASINO_AGGREGATOR=

# NOT: Compose yalnız app + mongo + caddy çalıştırır. game-host ve odds-provider
# (Betting / In-house Games eklentileri) Docker dışıdır; ilgili değişkenler
# (GAME_HOST_*, ODDS_PROVIDER_*, PROVIDER_SESSION_SECRET ...) için
# server/.env.example'a bak.
