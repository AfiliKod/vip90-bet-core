# Environment variables for the VIP90.bet Docker installation.
# Usage: cp .env.docker.example .env  → fill in the values → docker compose up -d
#
# Do NOT put MONGODB_URI in .env — docker-compose.yml points it at the mongo
# service inside Compose (mongodb://mongo:27017/betzone?replicaSet=rs0).
# The full list of variables is in server/.env.example and
# docs/product/02-yapilandirma.md.

# ─── Required ─────────────────────────────────────────────────────
# Domain Caddy obtains a certificate for. "localhost" (or empty) serves a
# self-signed certificate for local testing.
DOMAIN=localhost

# Two different random values: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_random_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_chars

# Public address players open in the browser (https:// with a real domain)
CLIENT_URL=https://localhost

# ─── Recommended ──────────────────────────────────────────────────
# AES-256-GCM key for secrets saved from the admin panel (SMTP, Slikair, SMS…),
# 64 hex characters. Keep a backup: if it changes, saved secrets cannot be read.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_SECRET_ENCRYPTION_KEY=

# Email (verification, password reset, system emails). Can also be set later
# in Settings → Modules → Email Gateway. Without email, players cannot verify
# their address; an admin can mark it verified in Users → user → Email verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Optional ─────────────────────────────────────────────────────
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Cloudflare Turnstile: when BOTH are set, register/login/forgot-password
# require it. Empty means off. DISABLE_TURNSTILE=true always skips it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DISABLE_TURNSTILE=

# Comma-separated IP/CIDR list allowed to reach /api/admin/* (empty: no limit)
ADMIN_ALLOWED_IPS=

# ─── Modules ──────────────────────────────────────────────────────
# Slikair payment gateway (see server/.env.example)
SLIKAIR_MERCHANT_ID=
SLIKAIR_MERCHANT_TOKEN=
SLIKAIR_SITE_ID=
SLIKAIR_BASE_URL=https://sandbox.slikair.online/api/v2
SLIKAIR_WEBHOOK_SECRET=
API_BASE_URL=

# Crypto payment module (USDT TRC20) — keep secret, back up
USDT_TRY_RATE=35
TRON_NETWORK=mainnet
CRYPTO_SEED_PHRASE=
HOT_WALLET_PRIVATE_KEY=

# Support chatbot (OpenRouter)
AI_HELP_BASE_URL=https://openrouter.ai/api/v1
AI_HELP_API_KEY=
AI_HELP_MODEL=anthropic/claude-3-haiku

# Social login. Google login is normally set in Settings → Modules →
# Google Login (panel values win); these are only a fallback. An empty
# redirect URI defaults to CLIENT_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Central license server (leave empty if you do not have one)
LICENSE_SERVER_URL=
LICENSE_KEY=

# ─── Paid add-ons ─────────────────────────────────────────────────
# Casino Content add-on: provider credentials (leave empty without the add-on;
# they can also be entered in Settings → Modules → Casino Content).
PALACE_API_BASE=
PALACE_API_TOKEN=
PALACE_CALLBACK_TOKEN=
CASINO_AGGREGATOR=

# Compose runs only app + mongo + caddy. game-host and odds-provider
# (In-house Games / Sports Betting add-ons) run outside Docker; their variables
# (GAME_HOST_*, ODDS_PROVIDER_*, PROVIDER_SESSION_SECRET …) are listed in
# server/.env.example.
