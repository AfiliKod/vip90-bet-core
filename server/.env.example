# ─── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/betzone?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# ─── JWT Secrets (rotate BEFORE launch) ──────────────────────────
JWT_SECRET=BURAYA_RANDOM_64_CHARS_openssl_rand_base64_64
JWT_REFRESH_SECRET=BURAYA_FARKLI_RANDOM_64_CHARS

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CLIENT_URL=https://vip90.bet

# ─── Casino provider (Palace) ─────────────────────────────────────
PALACE_API_BASE=https://api.casino-provider.example
PALACE_API_TOKEN=CHANGE_ME_palace_token
PALACE_CALLBACK_TOKEN=CHANGE_ME_palace_callback_token

# ─── Crypto (USDT TRC20) ──────────────────────────────────────────
USDT_TRY_RATE=35
TRONGRID_API_KEY=

# ─── AI Help (OpenRouter) ─────────────────────────────────────────
AI_HELP_BASE_URL=https://openrouter.ai/api/v1
AI_HELP_API_KEY=CHANGE_ME_openrouter_key
AI_HELP_MODEL=anthropic/claude-3-haiku

# ─── SMTP (Transactional email — Phase C9) ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vip90.bet
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@vip90.bet

# ─── Monitoring (Phase C2/C3) ─────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/123456
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ─── Bot protection (Phase B8 — Turnstile) ────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Admin (Phase B15) ────────────────────────────────────────────
ADMIN_ALLOWED_IPS=

# ─── Feature flags ────────────────────────────────────────────────
DISABLE_TURNSTILE=true
LEGAL_VERSION=1.0.0

# Legacy — kullanılmıyor
ODDS_API_KEY=

# ─── oddsSource HTTP relay (bölgesel Cloudflare PoP sorunu için) ─────
# Bazı barındırma bölgeleri Cloudflare tarafından oddsSource origin'ine
# bağlanamayan bir PoP'a yönlendiriliyor (getdata.php istekleri anlık
# HTTP 520 döner — timeout değil, Cloudflare'in kendisi origin'e
# ulaşamıyor). Canlı WebSocket akışı (nodeupd) bundan etkilenmeyebilir,
# ama HTTP tabanlı senkronizasyon (upcoming odds, tam lig taraması)
# TAMAMEN durur. Belirti: health endpoint'te sync.upcomingOdds "stale"
# ve lastSuccessAt: null kalır. Çözüm: oddsSource origin'ine ulaşabilen bir
# bölgede küçük bir HTTP proxy relay'i (ör. tinyproxy) çalıştırıp burada
# tanımlamak — format: http://kullanici:sifre@host:port
# Boşsa proxy hiç kullanılmaz, istekler doğrudan gider.
oddsSource_PROXY_URL=