# ─── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/betzone?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# ─── JWT Secrets (rotate BEFORE launch) ──────────────────────────
JWT_SECRET=BURAYA_RANDOM_64_CHARS_openssl_rand_base64_64
JWT_REFRESH_SECRET=BURAYA_FARKLI_RANDOM_64_CHARS

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CLIENT_URL=https://vip90.bet

# SPA 404 kipi. Varsayılan (tanımlı değil) = ZORLAMA: rota tablosunda
# (client/dist/routes.json) olmayan sayfa 404 + X-Robots-Tag:noindex döner.
# 1 = RAPOR MODU: davranış değişmez (tüm yollar 200), yalnızca
# "[route-404] (rapor modu) manifest dışı: <yol>" loglanır — yayına geçişin
# 1. fazı için. Ayrıntı: docs/seo-settings.md
# ROUTE_404_REPORT_ONLY=1

# ─── Casino provider (Palace) ─────────────────────────────────────
PALACE_API_BASE=https://api.casino-provider.example
PALACE_API_TOKEN=CHANGE_ME_palace_token
PALACE_CALLBACK_TOKEN=CHANGE_ME_palace_callback_token
# Callback kaynak IP kısıtı (F2). Virgüllü IP/CIDR: sağlayıcının callback sunucuları
# (sağlayıcıdan isteyin; callback imzası belgelenmediği için önerilir). Tanımlıysa
# listede olmayan adres POST /api/igames/callback'te 401 {code:1001} alır. Boş: yalnız
# token, açılışta uyarı. ADMIN_ALLOWED_IPS ile aynı kurallar: geçersiz girdiler yok
# sayılır, hiç geçerli girdi yoksa TÜM callback'ler reddedilir. İstemci IP'si req.ip'tir;
# Cloudflare arkasında önce proxy'de gerçek IP'yi geri yükleyin (ya da
# ADMIN_IP_TRUST_CF_HEADER=true; admin listesiyle ortaktır). Test callback'iyle doğrulayın.
# IGAMES_CALLBACK_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
IGAMES_CALLBACK_ALLOWED_IPS=

# ─── Game Host (inhouse oyunlar — sağlayıcı formatı) ──────────────
# İçerideki (Crash, Mines, ...) oyunların gerçek arayüz kodu artık ayrı
# barındırılan game-host/ uygulamasında yaşıyor; ana client yalnızca kısa
# ömürlü imzalı bir URL isteyip iframe'e gömüyor (Palace launchGame() ile
# aynı desen). GAME_HOST_SECRET, JWT_SECRET'tan FARKLI olmalı — bu token'ın
# güven sınırı normal oturumdan ayrı tutuluyor.
GAME_HOST_URL=http://localhost:5174
GAME_HOST_SECRET=BURAYA_FARKLI_RANDOM_64_CHARS

# ─── Çok-kiracılı game provider (server/src/provider/) ────────────
# Merkezi oyun sunucusunun kendi güven sınırı — game-host'un ilk yüklemesini
# yetkilendiren GAME_HOST_SECRET'tan AYRI: bu, /session'ın döndürdüğü, gerçek
# oyun soketinin (crashGame.js) kullandığı ~15dk'lık oturum token'ını imzalar.
PROVIDER_SESSION_SECRET=BURAYA_ÜÇÜNCÜ_FARKLI_RANDOM_64_CHARS
OPERATOR_ORIGIN_CACHE_TTL_MS=30000
WALLET_CALLBACK_MAX_RETRY_ATTEMPTS=10
WALLET_CALLBACK_RETRY_BASE_MS=5000

# Bir in-house oyun oturumunun varsayılan tavanı (dakika). Oyuncu kendi
# oturum limitini kurduysa (Sorumlu Oyun sayfası) DAHA KISSA O KAZANIR.
# 5-1440 arasına kırpılır. Tavan dolunca oturum kapanır, sonraki launch yeni
# oturum açar ve turlar SESSION_LIMIT_REACHED ile reddedilir.
INHOUSE_SESSION_MAX_MINUTES=120

# ─── In-house provider client (bu site, "Operatör #1" olarak) ─────
# scripts/migrations/create-operator-one.mjs çalıştırıldığında STDOUT'a
# basılan değerlerle doldurulur (apiKeySecret bir daha gösterilmez). Admin
# panelden "rotate" yapıldıktan SONRA bu iki değer artık okunmaz (Operator
# kaydındaki apiKeySecretEncrypted'a geçilir) — ilk kurulumda/rotate
# edilmemiş operatörlerde hâlâ fallback olarak kullanılır.
INHOUSE_PROVIDER_API_BASE=http://localhost:3001
INHOUSE_PROVIDER_API_KEY_ID=
INHOUSE_PROVIDER_API_SECRET=

# Operator.apiKeySecretEncrypted (ve ileride başka provider sırları) için
# AES-256-GCM anahtarı — 32 byte, hex ile yazılır (64 hex karakter).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Since PR-1 (V1) it also encrypts users' 2FA secrets and backup codes (`enc:v1:`).
# REQUIRED in production: without it, writes of encrypted secrets (2FA setup,
# panel-saved secrets) fail closed. Back it up outside the server: if the key is
# lost or changed, encrypted 2FA secrets become unreadable and those users can no
# longer pass 2FA login. Never rotate it casually. After first defining it run
# `node scripts/migrate-encrypt-secrets.mjs` (dry run), then `--commit`.
# Since PR-2 (V12) it also encrypts the KYC provider secrets (SUMSUB_APP_TOKEN,
# SUMSUB_SECRET_KEY, SUMSUB_WEBHOOK_SECRET). If it is missing or changed they become
# unreadable: the Sumsub webhook answers 503 and KYC API calls fail.
OPERATOR_SECRET_ENCRYPTION_KEY=

# KYC identity documents (PR-2, V3). Served only through the authenticated
# GET /api/kyc/documents/:id. Default: server/storage/kyc. MUST persist across
# deploys: set an ABSOLUTE path outside DEPLOY_PATH (e.g. /var/lib/vip90/kyc-storage, mode 700):
# deploy's rsync -a resets the mode of server/storage/kyc, so chmod there does not survive.
# Back it up. Run the migration (`node scripts/migrate-kyc-uploads.mjs`, dry run, then
# `--commit`, `--from <dir>` for extra legacy dirs) with this same server/.env and from the
# service's WorkingDirectory (`systemctl show vip90-node -p WorkingDirectory`).
KYC_UPLOAD_DIR=

# ─── Crypto (USDT TRC20) — crypto-payment modülü ──────────────────
USDT_TRY_RATE=35
# mainnet | nile | shasta (varsayılan: mainnet; admin panel ayarı önceliklidir)
TRON_NETWORK=mainnet
# Sıcak cüzdan: HOT_WALLET_PRIVATE_KEY varsa o kullanılır, yoksa seed phrase'ten
# türetilir. Kullanıcı yatırma adresleri CRYPTO_SEED_PHRASE'ten türetilir —
# ikisi de GİZLİ; yedeksiz kaybetmeyin, repoya koymayın.
CRYPTO_SEED_PHRASE=
HOT_WALLET_PRIVATE_KEY=

# ─── AI Help (OpenRouter) ─────────────────────────────────────────
AI_HELP_BASE_URL=https://openrouter.ai/api/v1
AI_HELP_API_KEY=CHANGE_ME_openrouter_key
AI_HELP_MODEL=anthropic/claude-3-haiku

# ─── E-posta (transactional — Phase C9) ──────────────────────────
# Mailtrap Email API (2026-10-30): MAILTRAP_TOKEN tanımlı VE SMTP_PROVIDER=mailtrap
# ise gönderim SMTP değil Mailtrap Sending API ile yapılır. Token'ı Mailtrap →
# Settings → API Tokens (Admin erişimli) sayfasından alın; gövdenin size ait bir
# API token'ı olduğundan .env dışında bir yere (commit, issue, sohbet) yazmayın.
MAILTRAP_TOKEN=CHANGE_ME_mailtrap_api_token
# Sandbox=true → mailler yalnızca Mailtrap Sandbox gelen kutusuna gider, gerçek
# alıcıya çıkmaz (staging/CI için). Sandbox açıksa MAILTRAP_INBOX_ID zorunludur.
MAILTRAP_SANDBOX=false
MAILTRAP_INBOX_ID=

# SMTP — yalnızca mailtrap DIŞI sağlayıcılar için kullanılır (host/provider
# eşleşmesi: emailConfig.resolveEmailMode).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vip90.bet
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@vip90.bet
# Panelden de girilebilir: Settings → Modules → Email Gateway (panel önceliklidir).
# SMTP_GATEWAY_ENABLED=false → panel yok sayılır, yalnız bu .env değerleri kullanılır.
SMTP_FROM_NAME=
SMTP_PROVIDER=
SMTP_GATEWAY_ENABLED=true
# Baskılanmış alıcı domainleri (virgülle ayrılmış): bu domainlere (ve alt
# domainlerine) HİÇ mail gönderilmez — sağlayıcıya emisyon bile gitmez.
# Varsayılan: seed.local,test.local,local  ('local' ayrılmış TLD'dir, demo/seed
# ve e2e hesapları teslim edilemez). Listeyi boş bırakmak baskılamayı kapatır.
MAIL_SUPPRESS_EMAIL_DOMAINS=
# Sistem e-postaları: toplu gönderimde tek seferdeki alıcı tavanı (varsayılan 500,
# en çok 5000); MAIL_SYSTEM_DISABLED=true tüm sistem e-postalarını durdurur.
MAIL_SEND_BATCH_LIMIT=
MAIL_SYSTEM_DISABLED=

# ─── SMS Gateway (Twilio) ─────────────────────────────────────────
# Panelden de girilebilir: Settings → Modules → SMS Gateway (panel önceliklidir;
# Auth Token'ı panelden kaydetmek OPERATOR_SECRET_ENCRYPTION_KEY ister).
# Gönderici için FROM_NUMBER ya da MESSAGING_SERVICE_SID'den biri yeterli.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY_CODE=

# ─── Monitoring (Phase C2/C3) ─────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/123456
# Uyarı kanalları (admin panelden de ayarlanabilir; DB değeri env'e öncelikli)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=

# ─── Bot protection (Cloudflare Turnstile) — VARSAYILAN KAPALI ────
# İkisi birlikte tanımlıysa register / login / forgot-password Turnstile
# doğrulaması ister (istemcide widget otomatik çıkar). Biri boşsa kapalı.
# DISABLE_TURNSTILE=true tanımlıysa anahtarlar dolu olsa bile atlanır.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DISABLE_TURNSTILE=

# ─── Admin IP kısıtı — VARSAYILAN KAPALI ──────────────────────────
# Virgüllü IP/CIDR listesi (ör: 203.0.113.5,10.0.0.0/8,2001:db8::/32).
# Tanımlıysa her personel ucu (/api/admin/*, ticket/chat admin, /api/bank/admin/*, kripto
# ayarları, 2FA setup/verify/disable, igames personel uçları) ve canlı admin socket odası
# yalnız bu IP'lerden kabul edilir (403 ADMIN_IP_NOT_ALLOWED); giriş uçları kapsam dışı.
# Kilitlenirseniz: bu dosyayı düzeltip servisi yeniden başlatın (değer açılışta okunur);
# listenin tamamı geçersizse herkes reddedilir. İstemci IP'si `req.ip`'tir
# (trust proxy = 1). Cloudflare arkasında gerçek IP req.ip'e yansımıyorsa ve
# origin'e yalnız Cloudflare erişebiliyorsa CF-Connecting-IP'yi açın:
ADMIN_ALLOWED_IPS=
ADMIN_IP_TRUST_CF_HEADER=false

# ─── Demo anında yatırma — VARSAYILAN KAPALI ──────────────────────
# YALNIZ DEMO. true ise POST /api/transactions/deposit bakiyeyi ÖDEME ALMADAN yükler
# (satış demosu). Kapalıyken 404 DEMO_FEATURE_DISABLED. TENANCY_MODE=multi iken
# yok sayılır (yalnız tek operatör modunda çalışır). Gerçek para kurulumunda açmayın.
DEMO_INSTANT_DEPOSIT=false

# ─── E-posta doğrulama (grandfathering) ───────────────────────────
# Bu ISO 8601 tarihten ÖNCE kayıt olanlar giriş sırasında e-posta doğrulamadan
# muaftır. Boşsa koddaki varsayılan (2026-07-14T00:00:00Z) kullanılır.
EMAIL_VERIFICATION_CUTOFF=

# ─── Lisans ve aggregator seçimi ──────────────────────────────────
# İkisi de tanımlıysa modül lisansları merkez lisans sunucusundan doğrulanır;
# tanımsızsa lisans kontrolü yapılmaz (yalnız panel anahtarı geçerli).
LICENSE_SERVER_URL=
LICENSE_KEY=
# Aktif casino aggregator (varsayılan: igames). Bkz. services/casinoAggregators.
CASINO_AGGREGATOR=

# ─── Diğer ────────────────────────────────────────────────────────
SUPPORT_EMAIL=destek@vip90.bet
# Yatırma ekranında gösterilen banka bilgileri (bank controller varsayılanları)
BANK_NAME=
BANK_HOLDER=
BANK_IBAN=
BANK_BRANCH=
# Bot servisi iç API tabanı (varsayılan: http://localhost:$PORT)
INTERNAL_API_URL=
# server/scripts/seed.js — ilk admin kullanıcısı (opsiyonel)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Lisanslı odds sağlayıcı (The Odds API) — ŞU AN ETKİSİZ ───────
# premium/betting/oddsProviders kayıt defteri bu değişkenleri okur ama sync
# job'ları henüz getActiveOddsProvider()'ı çağırmıyor: ODDS_PROVIDER ne olursa
# olsun kaynak aşağıdaki odds-provider uygulamasıdır. Seçim bağlanana kadar
# bunları doldurmanız bir şey değiştirmez.
ODDS_API_KEY=
ODDS_API_SPORT=soccer_epl
ODDS_PROVIDER=internalProvider

# ─── Odds veri sağlayıcısı (ayrı odds-provider/ uygulaması) ────────
# Canlı/yaklaşan bahis oranı verisinin gerçek kaynağı (mirror domain keşfi,
# HTML parse, nodeupd WebSocket) artık bu kod tabanında DEĞİL — ayrı, satılan
# pakete DAHİL EDİLMEYEN `odds-provider/` uygulamasında yaşıyor (bkz.
# odds-provider/.env.example). Bu iki değişken o uygulamaya nasıl bağlanılacağını
# tanımlar. Kod varsayılanı: odds-provider PORT=3002 (server.js) ve istemci
# ODDS_PROVIDER_API_BASE=http://localhost:3002. odds-provider'ı başka bir
# portta (ör. örnek dosyasındaki 3003) çalıştırıyorsanız buradaki URL'yi de
# AYNI porta çekin.
#
# DİKKAT: Bu URL'i (veya odds-provider'ın PORT'unu) değiştirdiğinde İKİ
# process'i de restart etmen gerekir — server/'ı ÇALIŞTIRAN process bu
# değeri yalnızca açılışta okur, .env dosyasını değiştirmek kendi başına
# hiçbir şeyi etkilemez (2026-09-07'de bu unutulunca saatlerce sessizce
# yanlış porta bağlanmaya devam etmişti).
ODDS_PROVIDER_API_BASE=http://localhost:3002
ODDS_PROVIDER_API_TOKEN=

# Admin panelden token rotate edildiğinde bu sunucunun odds-provider'a yeni
# değeri push'layabilmesi için (restart'sız) — odds-provider/.env'deki AYNI
# isimli değişkenle EŞLEŞMELİ. Operasyonel Bearer token'dan (yukarıdaki
# ODDS_PROVIDER_API_TOKEN) TAMAMEN AYRI bir sır.
ODDS_PROVIDER_MANAGEMENT_SECRET=

# ─── Sosyal giriş (P5) ─────────────────────────────────────────────
# Google Cloud Console'da bir OAuth 2.0 Client ID oluşturulmalı;
# yetkili redirect URI olarak GOOGLE_REDIRECT_URI kayıtlı olmalı.
# Normalde panelden girilir: Settings → Modules → Google Login (panel
# değeri buradakinden önceliklidir). Buton yalnız kart anahtarı açık
# (GOOGLE_LOGIN_ENABLED, varsayılan açık) ve CLIENT_ID + SECRET doluysa
# görünür. REDIRECT_URI boşsa CLIENT_URL'deki ilk origin +
# /api/auth/google/callback kullanılır.
GOOGLE_LOGIN_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
#
# Telegram Login Widget için BotFather'dan AYRI bir bot oluşturulmalı —
# TELEGRAM_BOT_TOKEN (yukarıda, admin bildirim botu) ile KARIŞTIRILMAMALI,
# Login Widget botunun /setdomain ile prod domain'e kayıtlı olması gerekir.
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Web3 cüzdan girişi (P6) ───────────────────────────────────────
# Dış kimlik bilgisi gerekmez (imza doğrulama sunucu tarafında ethers ile
# yapılıyor) — yalnızca tarayıcı-içi cüzdan (MetaMask vb.) destekleniyor.

# ─── Slikair Ödeme Ağ Geçidi ───────────────────────────────────────
# Sandbox credentials (test): https://sandbox.slikair.online/dashboard
# Production credentials: Slikair merchant panelinden alınır.
SLIKAIR_MERCHANT_ID=
SLIKAIR_MERCHANT_TOKEN=
SLIKAIR_SITE_ID=
# Production base URL: https://api.slikair.online/api/v2 (sandbox: https://sandbox.slikair.online/api/v2)
SLIKAIR_BASE_URL=https://sandbox.slikair.online/api/v2
# Webhook secret (Slikair HMAC imza doğrulama — opsiyonel)
SLIKAIR_WEBHOOK_SECRET=
# API_BASE_URL: Webhook'ların Slikair'e bildirildiği public URL (opsiyonel).
# Bu URL Slikair'e notification_link olarak gönderilir.
# Mimari same-origin olduğu için (client `/api` base URL kullanıyor, ayrı bir
# "api." subdomain'i YOK) boş bırakılırsa CLIENT_URL (ör. https://vip90.bet)
# kullanılır — bu genelde doğru davranıştır. Yalnızca GERÇEKTEN ayrı bir API
# host'unuz varsa burayı doldurun.
API_BASE_URL=
