# ─── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/betzone?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# ─── JWT Secrets (rotate BEFORE launch) ──────────────────────────
JWT_SECRET=BURAYA_RANDOM_64_CHARS_openssl_rand_base64_64
JWT_REFRESH_SECRET=BURAYA_FARKLI_RANDOM_64_CHARS

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CLIENT_URL=https://vip90.bet

# ─── Casino provider (Palace) ─────────────────────────────────────
PALACE_API_BASE=https://api.casino-provider.example
PALACE_API_TOKEN=CHANGE_ME_palace_token
PALACE_CALLBACK_TOKEN=CHANGE_ME_palace_callback_token

# ─── Crypto (USDT TRC20) ──────────────────────────────────────────
USDT_TRY_RATE=35
TRONGRID_API_KEY=

# ─── AI Help (OpenRouter) ─────────────────────────────────────────
AI_HELP_BASE_URL=https://openrouter.ai/api/v1
AI_HELP_API_KEY=CHANGE_ME_openrouter_key
AI_HELP_MODEL=anthropic/claude-3-haiku

# ─── SMTP (Transactional email — Phase C9) ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vip90.bet
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@vip90.bet

# ─── Monitoring (Phase C2/C3) ─────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/123456
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ─── Bot protection (Phase B8 — Turnstile) ────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Admin (Phase B15) ────────────────────────────────────────────
ADMIN_ALLOWED_IPS=

# ─── Feature flags ────────────────────────────────────────────────
DISABLE_TURNSTILE=true
LEGAL_VERSION=1.0.0

# ─── Lisanslı odds sağlayıcı (The Odds API) ───────────────────────
# ODDS_PROVIDER=theoddsapi yapıldığında aktif olur (varsayılan: oddsSource).
#
# UYARI: Bu ayar yalnızca odds normalizasyon/parse mantığını seçer.
# server.js'in koşulsuz başlattığı canlı ve fikstür senkronizasyon job'ları
# (startOddsSourceLiveSync, startOddsSourceUpcomingSync) bu ayardan BAĞIMSIZ
# çalışır — her zaman ODDS_SOURCE_HOST_TEMPLATE ile tanımlı kaynağın ayna
# domain'ini keşfedip WebSocket'le bağlanır. ODDS_PROVIDER=theoddsapi yapmak
# bu trafiği DURDURMAZ. Satış öncesi gerçek bir sağlayıcı değişimi (theoddsapi
# için yeni bir senkronizasyon job'ı + server.js'te provider'a göre gate) ayrı,
# henüz yapılmamış bir mühendislik işidir.
ODDS_API_KEY=
ODDS_API_SPORT=soccer_epl
ODDS_PROVIDER=oddsSource

# ─── Odds kaynağı mirror domain şablonu ────────────────────────────
# Kaynağın mirror domain'lerinin ortak öneki (host, sayı hariç — ör.
# "bet.example"). Gerçek değer yalnızca bu dosyanın commit'lenmeyen kopyasında
# ("server/.env") yaşamalı, kaynak koda asla yazılmamalı. Boşsa domain keşfi
# hiçbir şey bulamaz.
ODDS_SOURCE_HOST_TEMPLATE=

# ─── Odds kaynağı HTTP relay (bölgesel Cloudflare PoP sorunu için) ─
# Bazı barındırma bölgeleri Cloudflare tarafından kaynağın origin'ine
# bağlanamayan bir PoP'a yönlendiriliyor (getdata.php istekleri anlık
# HTTP 520 döner — timeout değil, Cloudflare'in kendisi origin'e
# ulaşamıyor). Canlı WebSocket akışı (nodeupd) bundan etkilenmeyebilir,
# ama HTTP tabanlı senkronizasyon (upcoming odds, tam lig taraması)
# TAMAMEN durur. Belirti: health endpoint'te sync.upcomingOdds "stale"
# ve lastSuccessAt: null kalır. Çözüm: kaynağın origin'ine ulaşabilen bir
# bölgede küçük bir HTTP proxy relay'i (ör. tinyproxy) çalıştırıp burada
# tanımlamak — format: http://kullanici:sifre@host:port
# Boşsa proxy hiç kullanılmaz, istekler doğrudan gider.
ODDS_SOURCE_PROXY_URL=

# ─── Odds kaynağı elle beslenen çerezler / tarama ayarları ─────────
# Cookie-Editor vb. ile elle export edilmiş çerezler (cookies.json dosyası
# öncelikli; bu env yalnızca dosya yoksa okunur).
ODDS_SOURCE_COOKIES=
# Domain keşfi tarama pencereleri — varsayılanlar çoğu durumda yeterli,
# yalnızca keşif sürekli başarısız oluyorsa değiştirin.
ODDS_SOURCE_SCAN_AHEAD=
ODDS_SOURCE_WIDE_SCAN_AHEAD=
ODDS_SOURCE_DNS_CONCURRENCY=

# ─── Sosyal giriş (P5) ─────────────────────────────────────────────
# Google Cloud Console'da bir OAuth 2.0 Client ID oluşturulmalı;
# yetkili redirect URI olarak GOOGLE_REDIRECT_URI kayıtlı olmalı.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
#
# Telegram Login Widget için BotFather'dan AYRI bir bot oluşturulmalı —
# TELEGRAM_BOT_TOKEN (yukarıda, admin bildirim botu) ile KARIŞTIRILMAMALI,
# Login Widget botunun /setdomain ile prod domain'e kayıtlı olması gerekir.
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Web3 cüzdan girişi (P6) ───────────────────────────────────────
# Dış kimlik bilgisi gerekmez (imza doğrulama sunucu tarafında ethers ile
# yapılıyor) — yalnızca tarayıcı-içi cüzdan (MetaMask vb.) destekleniyor.