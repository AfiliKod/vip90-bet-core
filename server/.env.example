# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster.mongodb.net/betzone

# JWT — en az 32 karakter rastgele string (örn: openssl rand -hex 32)
JWT_SECRET=BURAYA_GUCLU_RASTGELE_STRING_KOY
JWT_REFRESH_SECRET=BURAYA_FARKLI_GUCLU_RASTGELE_STRING_KOY

# Server portu — Render bunu otomatik set eder
PORT=3001

# Üretim ortamı
NODE_ENV=production

# CORS — frontend URL'i (Render'da: https://betzone.onrender.com)
# Birden fazla URL virgülle ayır: https://domain1.com,https://domain2.com
# Geçici olarak * kullanılabilir ama güvenlik riski taşır
CLIENT_URL=https://SENIN-RENDER-SUBDOMAININ.onrender.com

# Kullanılmıyor ama .env'de kalsın
ODDS_API_KEY=
