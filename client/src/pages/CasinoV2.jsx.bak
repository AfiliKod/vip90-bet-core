import { useState, useEffect, useMemo } from 'react';
import { Link } from 'react-router-dom';
import { CASINO_GAMES } from '../data/casinoGames';

// ── Veri ──────────────────────────────────────────────────────────────────────
const byProvider = (provider, requireImage = true) =>
  CASINO_GAMES.filter(g => g.provider === provider && g.demoUrl && (!requireImage || g.image));

const PROVIDER_GAMES = {
  BGaming:          byProvider('BGaming'),
  'Pragmatic Play': byProvider('Pragmatic Play'),
  Wazdan:           byProvider('Wazdan'),
  Endorphina:       byProvider('Endorphina'),
  Fugaso:           byProvider('Fugaso'),
  'Relax Gaming':   byProvider('Relax Gaming', false),
  Palace:           [], // Fetched from API dynamically
};

const GRADIENTS = [
  'from-violet-800 to-indigo-900', 'from-emerald-800 to-teal-900',
  'from-rose-800 to-pink-900',     'from-amber-800 to-orange-900',
  'from-sky-800 to-blue-900',      'from-fuchsia-800 to-purple-900',
  'from-cyan-800 to-sky-900',      'from-red-800 to-rose-900',
];
function gameGradient(id) {
  let h = 0;
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
  return GRADIENTS[h % GRADIENTS.length];
}

const INHOUSE_GAMES = [
  { id: 'crash',       title: 'Noel Baba',   emoji: '🎅', desc: 'Katsayı uçmadan önce çık',       path: '/games/crash',       color: 'from-orange-700 to-red-900',    thumb: '/images/games/crash.png' },
  { id: 'mines',       title: 'Mines',        emoji: '💎', desc: 'Mayınları bul, elmasları topla',  path: '/games/mines',       color: 'from-green-700 to-emerald-900', thumb: '/images/games/mines.png' },
  { id: 'plinko',      title: 'Plinko',       emoji: '⚡', desc: 'Topu bırak, kazancı yakala',      path: '/games/plinko',      color: 'from-purple-700 to-violet-900', thumb: '/images/games/plinko.png' },
  { id: 'dice',        title: 'Dice',         emoji: '🎲', desc: 'Zarı at, çarpanını seç',          path: '/games/dice',        color: 'from-blue-700 to-cyan-900',     thumb: '/images/games/dice.png' },
  { id: 'limbo',       title: 'Limbo',        emoji: '🎯', desc: 'Hedef katsayıyı geç',             path: '/games/limbo',       color: 'from-pink-700 to-rose-900',     thumb: '/images/games/limbo.png' },
  { id: 'wheel',       title: 'Wheel',        emoji: '🎡', desc: 'Çarkı çevir, talihi dene',        path: '/games/wheel',       color: 'from-yellow-600 to-amber-900',  thumb: '/images/games/wheel.png' },
  { id: 'hilo',        title: 'Hi-Lo',        emoji: '🃏', desc: 'Yüksek mi düşük mü tahmin et',   path: '/games/hilo',        color: 'from-indigo-700 to-violet-900', thumb: '/images/games/hilo.png' },
  { id: 'keno',        title: 'Keno',         emoji: '🔢', desc: '10 sayı seç, büyük kazan',        path: '/games/keno',        color: 'from-teal-700 to-emerald-900',  thumb: '/images/games/keno.png' },
  { id: 'blackjack',   title: 'Blackjack',    emoji: '🃏', desc: "21'e ulaş, krupiyeyi yen",        path: '/games/blackjack',   color: 'from-green-700 to-green-950',   thumb: '/images/games/blackjack.png' },
  { id: 'roulette',    title: 'Rulet',        emoji: '🎡', desc: 'Topu döndür, şansını dene',       path: '/games/roulette',    color: 'from-red-700 to-red-950',       thumb: '/images/games/roulette.png' },
  { id: 'baccarat',    title: 'Bakara',       emoji: '👑', desc: 'Oyuncu mu banker mi kazanır',     path: '/games/baccarat',    color: 'from-yellow-700 to-yellow-950', thumb: '/images/games/baccarat.png' },
  { id: 'videopoker',  title: 'Video Poker',  emoji: '♠',  desc: 'Jacks or Better poker',           path: '/games/videopoker',  color: 'from-purple-700 to-indigo-950', thumb: '/images/games/videopoker.png' },
  { id: 'dragontiger', title: 'Dragon Tiger', emoji: '🐉', desc: 'Dragon mı Tiger mı?',             path: '/games/dragontiger', color: 'from-orange-700 to-red-950',    thumb: '/images/games/dragontiger.png' },
];

const CATEGORIES = [
  { key: 'all',             label: 'Tümü' },
  { key: 'inhouse',         label: 'Orijinal' },
  { key: 'BGaming',         label: 'BGaming' },
  { key: 'Endorphina',      label: 'Endorphina' },
  { key: 'Fugaso',          label: 'Fugaso' },
  { key: 'Relax Gaming',    label: 'Relax Gaming' },
  { key: 'Palace',          label: 'Palace Casino' },
  { key: 'Pragmatic Play',  label: 'Pragmatic Play' },
  { key: 'Wazdan',          label: 'Wazdan' },
];

// ── Hooks ─────────────────────────────────────────────────────────────────────
function useGameStatus() {
  const [status, setStatus] = useState(null);
  useEffect(() => {
    fetch('/data/game-status.json').then(r => r.json()).then(setStatus).catch(() => setStatus({}));
  }, []);
  return status;
}

function filterWorking(games, providerName, status) {
  if (!status?.providers?.[providerName]) return games;
  const { working, skipped, stale } = status.providers[providerName];
  if (skipped || stale) return games;
  if (!working?.length) return games;
  const set = new Set(working);
  return games.filter(g => set.has(g.id));
}

// ── CasinoHero ────────────────────────────────────────────────────────────────
function CasinoHero() {
  return (
    <div
      className="relative h-44 sm:h-60 overflow-hidden rounded-2xl"
      style={{ background: 'linear-gradient(135deg, #05080f 0%, #0a0515 50%, #05080f 100%)' }}
    >
      {/* Neon ızgara */}
      <div
        className="absolute inset-0 opacity-[0.07]"
        style={{
          backgroundImage: 'linear-gradient(#00d4ff 1px, transparent 1px), linear-gradient(90deg, #00d4ff 1px, transparent 1px)',
          backgroundSize: '40px 40px',
        }}
      />
      {/* Radyal parlamalar */}
      <div
        className="absolute inset-0"
        style={{
          background:
            'radial-gradient(ellipse at 50% 130%, #9d00ff22 0%, transparent 65%), radial-gradient(ellipse at 80% 10%, #00d4ff18 0%, transparent 55%)',
        }}
      />
      {/* Scan line */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          className="absolute w-full h-[2px] animate-scan-line"
          style={{ background: 'linear-gradient(90deg, transparent 0%, #00d4ff 50%, transparent 100%)' }}
        />
      </div>
      {/* İçerik */}
      <div className="absolute inset-0 flex flex-col items-center justify-center gap-2 px-4 select-none">
        <h1
          className="text-5xl sm:text-7xl font-black tracking-[0.15em]"
          style={{ color: '#00d4ff', textShadow: '0 0 24px #00d4ff, 0 0 60px #00d4ff44' }}
        >
          CASINO
        </h1>
        <p className="text-xs sm:text-sm tracking-widest uppercase" style={{ color: '#8899bb' }}>
          2.000+ Oyun · Anlık Kazanç
        </p>
      </div>
    </div>
  );
}

// ── CategoryTabBar ────────────────────────────────────────────────────────────
function CategoryTabBar({ active, onChange }) {
  return (
    <div
      className="sticky z-40 -mx-4 px-3 flex gap-1 overflow-x-auto no-scrollbar border-b py-2"
      style={{ top: '56px', background: 'rgba(5,8,15,0.96)', backdropFilter: 'blur(10px)', borderColor: '#00d4ff1a' }}
    >
      {CATEGORIES.map(cat => {
        const isActive = active === cat.key;
        return (
          <button
            key={cat.key}
            onClick={() => onChange(cat.key)}
            className="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 whitespace-nowrap"
            style={
              isActive
                ? { color: '#00d4ff', background: '#00d4ff12', border: '1px solid #00d4ff44', boxShadow: '0 0 10px #00d4ff33' }
                : { color: '#8899bb', background: 'transparent', border: '1px solid transparent' }
            }
          >
            {cat.label}
          </button>
        );
      })}
    </div>
  );
}

// ── FeaturedCard ──────────────────────────────────────────────────────────────
function FeaturedCard({ game }) {
  const [imgErr, setImgErr] = useState(false);
  return (
    <Link
      to={`/casino/${game.id}`}
      className="group relative block rounded-xl overflow-hidden"
      style={{ aspectRatio: '16/9' }}
    >
      {game.image && !imgErr ? (
        <img
          src={game.image}
          alt={game.title}
          loading="lazy"
          className="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          onError={() => setImgErr(true)}
        />
      ) : (
        <div className={`absolute inset-0 bg-gradient-to-br ${gameGradient(game.id)}`} />
      )}
      {/* Hover neon border */}
      <div
        className="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
        style={{ boxShadow: 'inset 0 0 0 1px #00d4ff88, 0 0 24px #00d4ff44' }}
      />
      {/* Alt gradient */}
      <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
      <div className="absolute bottom-0 left-0 right-0 p-3 translate-y-1 group-hover:translate-y-0 transition-transform duration-300">
        <p className="text-white font-bold text-sm leading-tight truncate">{game.title}</p>
        {game.rtp && (
          <p className="text-[11px] mt-0.5 font-semibold" style={{ color: '#00ff88' }}>
            RTP {game.rtp}%
          </p>
        )}
      </div>
    </Link>
  );
}

// ── NeonCard (yoğun grid) ─────────────────────────────────────────────────────
function NeonCard({ game }) {
  const [imgErr, setImgErr] = useState(false);
  const [hovered, setHovered] = useState(false);
  return (
    <Link
      to={`/casino/${game.id}`}
      className="group relative block rounded-lg overflow-hidden transition-all duration-200"
      style={{
        border: hovered ? '1px solid #00d4ff55' : '1px solid #ffffff0f',
        boxShadow: hovered ? '0 0 10px #00d4ff1a' : 'none',
      }}
      onMouseEnter={() => setHovered(true)}
      onMouseLeave={() => setHovered(false)}
    >
      <div className="aspect-[3/4] w-full overflow-hidden" style={{ background: '#0c1220' }}>
        {game.image && !imgErr ? (
          <img
            src={game.image}
            alt={game.title}
            loading="lazy"
            className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onError={() => setImgErr(true)}
          />
        ) : (
          <div className={`w-full h-full bg-gradient-to-br ${gameGradient(game.id)} flex items-end p-1.5`}>
            <span className="text-white/90 text-[9px] font-bold leading-tight line-clamp-2">{game.title}</span>
          </div>
        )}
      </div>
      <div className="px-1.5 py-1" style={{ background: '#080d1a' }}>
        <p className="text-[10px] font-semibold truncate" style={{ color: '#c8d8f0' }}>{game.title}</p>
      </div>
    </Link>
  );
}

// ── InhouseNeonCard ───────────────────────────────────────────────────────────
function InhouseNeonCard({ game }) {
  const [hovered, setHovered] = useState(false);
  return (
    <Link
      to={game.path}
      className="group relative rounded-xl overflow-hidden cursor-pointer min-h-[110px] sm:min-h-[140px] transition-all duration-200"
      style={{
        border: hovered ? '1px solid #9d00ff88' : '1px solid #ffffff0f',
        boxShadow: hovered ? '0 0 14px #9d00ff33' : 'none',
      }}
      onMouseEnter={() => setHovered(true)}
      onMouseLeave={() => setHovered(false)}
    >
      <div className={`absolute inset-0 bg-gradient-to-br ${game.color}`} />
      {game.thumb && (
        <img
          src={game.thumb}
          alt=""
          loading="lazy"
          className="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-95 group-hover:scale-105 transition-all duration-500"
          onError={e => { e.target.style.display = 'none'; }}
        />
      )}
      <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
      <div className="absolute inset-0 z-10 flex flex-col justify-end p-2.5 sm:p-4">
        <div className="flex items-center gap-1.5 mb-1">
          <span
            className="text-[7px] sm:text-[8px] font-black px-1.5 py-0.5 rounded-full uppercase tracking-wide text-black"
            style={{ background: '#00d4ff' }}
          >
            Original
          </span>
          <span className="text-[7px] sm:text-[8px] bg-white/20 border border-white/25 text-white/80 px-1.5 py-0.5 rounded-full">
            Provably Fair
          </span>
        </div>
        <div className="text-white font-black text-sm sm:text-base leading-tight drop-shadow">{game.title}</div>
        <div className="hidden sm:block text-white/70 text-xs mt-0.5">{game.desc}</div>
      </div>
      <div className="absolute top-2.5 right-2.5 text-xl sm:text-2xl drop-shadow-lg">{game.emoji}</div>
    </Link>
  );
}

