        <p className="text-[10px] font-semibold truncate" style={{ color: '#c8d8f0' }}>{game.title}</p>
        {game.providerName && <p className="text-[9px] truncate" style={{ color: '#f59e0b' }}>{game.providerName}</p>}
      </div>
    </a>
  );
}

// ── DenseGrid ─────────────────────────────────────────────────────────────────
const STEP = 24;
function DenseGrid({ games }) {
  const [count, setCount] = useState(STEP);
  const visible = games.slice(0, count);
  if (!games.length) return null;
  return (
    <div>
      <div className="flex items-center justify-between mb-3">
        <h2 className="text-[10px] font-bold uppercase tracking-widest" style={{ color: '#8899bb' }}>
          Tüm Oyunlar
        </h2>
        <span className="text-[11px]" style={{ color: '#4a5a78' }}>{games.length} oyun</span>
      </div>
      <div className="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-8 gap-1.5 sm:gap-2">
        {visible.map(g => <NeonCard key={g.id} game={g} />)}
      </div>
      {count < games.length && (
        <button
          onClick={() => setCount(c => Math.min(c + STEP, games.length))}
          className="mt-4 w-full py-2.5 rounded-lg text-xs font-semibold transition-all duration-200"
          style={{ color: '#00d4ff', border: '1px solid #00d4ff33', background: 'transparent' }}
          onMouseEnter={e => { e.currentTarget.style.background = '#00d4ff0e'; }}
          onMouseLeave={e => { e.currentTarget.style.background = 'transparent'; }}
        >
          Daha fazla göster ({games.length - count} oyun kaldı)
        </button>
      )}
    </div>
  );
}

// ── Ana Bileşen ───────────────────────────────────────────────────────────────
export default function CasinoV2() {
  const [activeCategory, setActiveCategory] = useState('all');
  const [palaceGames, setPalaceGames] = useState([]);
  const [palaceLoading, setPalaceLoading] = useState(false);
  const status = useGameStatus();

  // Fetch Palace Casino games when Palace tab is selected
  useEffect(() => {
    if (activeCategory === 'palace' && palaceGames.length === 0 && !palaceLoading) {
      setPalaceLoading(true);
      fetch('/api/palace/game/list', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ limit: 100 }),
      })
        .then(r => r.json())
        .then(d => {
          if (d?.data?.items) {
            const items = d.data.items.map(g => ({
              id: g.game_id,
              title: g.game_name,
              provider: 'Palace',
              image: g.image || null,
              rtp: g.rtp || null,
              category: g.category || null,
              providerName: g.provider || '',
              isPalace: true,
            }));
            setPalaceGames(items);
          }
        })
        .catch(() => setPalaceGames([]))
        .finally(() => setPalaceLoading(false));
    }
  }, [activeCategory, palaceGames.length, palaceLoading]);

  const { featured, rest, isInhouse, isPalace } = useMemo(() => {
    if (activeCategory === 'inhouse') {
      return { featured: [], rest: [], isInhouse: true, isPalace: false };
    }
    if (activeCategory === 'palace') {
      return { featured: [], rest: palaceGames, isInhouse: false, isPalace: true };
    }
    let games;
    if (activeCategory === 'all') {
      games = Object.entries(PROVIDER_GAMES).flatMap(([name, list]) =>
        filterWorking(list, name, status)
      );
    } else {
      games = filterWorking(PROVIDER_GAMES[activeCategory] ?? [], activeCategory, status);
    }
    return { featured: games.slice(0, 3), rest: games.slice(3), isInhouse: false, isPalace: false };
  }, [activeCategory, status, palaceGames]);

  return (
    <div className="min-h-screen pb-16" style={{ background: '#05080f' }}>
      <div className="max-w-7xl mx-auto px-4 pt-4">
        <CasinoHero />
        <CategoryTabBar active={activeCategory} onChange={setActiveCategory} />

        <div className="mt-6 space-y-8">
          {/* Orijinal oyunlar */}
          {isInhouse && (
            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
              {INHOUSE_GAMES.map(g => <InhouseNeonCard key={g.id} game={g} />)}
            </div>
          )}

          {/* Featured row */}
          {!isInhouse && featured.length > 0 && (
            <div>
              <h2
                className="text-[10px] font-black uppercase tracking-widest mb-3"
                style={{ color: '#00d4ff', textShadow: '0 0 8px #00d4ff88' }}
              >
                Öne Çıkan
              </h2>
              <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {featured.map((g, i) => (
                  <div key={g.id} className={i === 2 ? 'hidden sm:block' : ''}>
                    <FeaturedCard game={g} />
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Palace Casino grid */}
          {isPalace && (
            <div>
              <div className="flex items-center justify-between mb-3">
                <h2 className="text-[10px] font-bold uppercase tracking-widest" style={{ color: '#8899bb' }}>
                  Palace Casino
                </h2>
                <span className="text-[11px]" style={{ color: '#4a5a78' }}>
                  {palaceLoading ? 'Yükleniyor...' : `${rest.length} oyun`}
                </span>
              </div>
              {palaceLoading ? (
                <div className="text-center py-12">
                  <div className="inline-block w-6 h-6 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin" />
                  <p className="text-xs mt-3" style={{ color: '#8899bb' }}>Palace Casino oyunları yükleniyor...</p>
                </div>
              ) : rest.length === 0 ? (
                <p className="text-center py-12 text-sm" style={{ color: '#8899bb' }}>
                  Palace Casino oyun bulunamadı
                </p>
              ) : (
                <div className="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-8 gap-1.5 sm:gap-2">
                  {rest.map(g => <PalaceCard key={g.id} game={g} />)}
                </div>
              )}
            </div>
          )}

          {/* Yoğun grid — key ile DenseGrid count sıfırlanır */}
          {!isInhouse && !isPalace && <DenseGrid key={activeCategory} games={rest} />}
        </div>
      </div>
    </div>
  );
}
